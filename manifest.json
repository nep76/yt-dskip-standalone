{
  "name": "YouTube DSkip Standalone",
  "version": "1.3.1",
  "manifest_version": 3,
  "description": "広告スキップボタンを代理クリックします。",
    "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [ "debugger", "tabs", "storage", "idle", "alarms" ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube DSkip Standalone"
  },
  "background" : {
    "service_worker": "yt-dskip-standalone-worker.js"
  },
  "commands": {
    "do-skip": {
      "suggested_key": {
        "default": "Ctrl+Shift+End"
      },
      "description": "スキップを手動実行する",
      "global": true
    }
  },
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "js": ["yt-dskip-standalone.js"]
  }]
}